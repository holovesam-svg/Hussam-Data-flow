      '<td style="padding:9px 10px;border-bottom:1px solid #dceaf3">' + escapeHtml_(item.site) + '</td>' +
      '<td style="padding:9px 10px;border-bottom:1px solid #dceaf3">' + escapeHtml_(item.label) + '</td>' +
      '<td style="padding:9px 10px;border-bottom:1px solid #dceaf3">' + escapeHtml_(item.category) + '</td>' +
      '<td style="padding:9px 10px;border-bottom:1px solid #dceaf3;white-space:nowrap">' + escapeHtml_(item.sheet + ' · row ' + item.row) + '</td>' +
