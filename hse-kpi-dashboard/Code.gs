/**
 * True only for a deployed Apps Script web-app /exec URL.
 * Drive file links, spreadsheet links, and /dev URLs are rejected.
 * ScriptApp.getService().getUrl() from a Sheet menu often returns a ghost
 * /exec URL that Google Drive cannot open.
 */
function isDeployedWebAppExecUrl_(url) {
  const value = String(url || '').trim();
  if (!value) return false;
  let parsed;
  try {
    parsed = new URL(value);
  } catch (err) {
    return false;
  }
  if (parsed.protocol !== 'https:') return false;
  if (parsed.hostname !== 'script.google.com') return false;
  return /\/s\/[^/]+\/exec$/i.test(parsed.pathname);
}

function getStoredWebAppUrl_() {
  const stored = String(
    PropertiesService.getScriptProperties().getProperty(LAUNCHER_CONFIG.WEB_APP_URL_PROPERTY) || ''
  ).trim();
  return isDeployedWebAppExecUrl_(stored) ? stored : '';
}

function saveWebAppUrl_(url) {
  const value = String(url || '').trim();
  if (!isDeployedWebAppExecUrl_(value)) {
    throw new Error(
      'That is not a deployed web app URL. In Apps Script choose Deploy → Manage deployments, ' +
      'copy the URL that ends with /exec, then save it here. Do not use a Drive file link or a /dev URL.'
    );
  }
  PropertiesService.getScriptProperties().setProperty(LAUNCHER_CONFIG.WEB_APP_URL_PROPERTY, value);
  return value;
}

/** Only reliable inside doGet() while serving a live /exec request. */
function captureWebAppUrlFromHttpContext_() {
  try {
    const url = ScriptApp.getService().getUrl();
    if (!isDeployedWebAppExecUrl_(url)) return;
    const props = PropertiesService.getScriptProperties();
    if (props.getProperty(LAUNCHER_CONFIG.WEB_APP_URL_PROPERTY) !== url) {
      props.setProperty(LAUNCHER_CONFIG.WEB_APP_URL_PROPERTY, url);
    }
  } catch (err) {
    // URL capture must never block serving the dashboard.
  }
}

