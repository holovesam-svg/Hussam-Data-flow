function setupDashboard() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  if (!ss) {
    throw new Error('Open the KPI Google Sheet, then run setupDashboard() from its bound Apps Script project.');
  }

  PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID', ss.getId());
  try {
    ensureVisitLogSheet_(ss);
  } catch (err) {
    // Visit logging must never block dashboard setup.
  }
  const present = CONFIG.SITE_SHEETS.filter(c => !!findSheet_(ss, c.sheet));
  buildDashboardMenu_();

  return {
    ok: true,
    spreadsheetId: ss.getId(),
    spreadsheetName: ss.getName(),
    sourceSheetsFound: present.length,
    expectedSourceSheets: CONFIG.SITE_SHEETS.length,
    webAppUrl: getStoredWebAppUrl_()
  };
}

