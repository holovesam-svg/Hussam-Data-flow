/** Dashboard API: global executive-card visibility, readable by every dashboard viewer. */
function getDashboardCardVisibility() {
  const allowedKeys = SUMMARY_CARD_CONFIG.CARDS.map(card => card.key);
  const raw = PropertiesService.getScriptProperties().getProperty(SUMMARY_CARD_CONFIG.PROPERTY_KEY);
  let visibleKeys = allowedKeys.slice();
  if (raw) {
    try {
      const parsed = JSON.parse(raw);
      if (Array.isArray(parsed)) visibleKeys = parsed.filter(key => allowedKeys.includes(key));
    } catch (err) {
      visibleKeys = allowedKeys.slice();
    }
  }
  return {
    cards: SUMMARY_CARD_CONFIG.CARDS.map(card => ({
      key: card.key,
      label: card.label,
      visible: visibleKeys.includes(card.key)
    })),
    visibleKeys: visibleKeys
  };
}

/** Dashboard API: saves one shared card selection for everyone who opens the dashboard. */
function saveDashboardCardVisibility(entries) {
  assertDashboardEmailAdmin_();
  if (!Array.isArray(entries)) throw new Error('The card selection is invalid.');
  const allowedKeys = SUMMARY_CARD_CONFIG.CARDS.map(card => card.key);
  const visibleKeys = Array.from(new Set(entries
    .filter(entry => entry && entry.visible && allowedKeys.includes(cleanCellText_(entry.key)))
    .map(entry => cleanCellText_(entry.key))));
  if (!visibleKeys.length) throw new Error('Select at least one dashboard card.');
  PropertiesService.getScriptProperties().setProperty(
    SUMMARY_CARD_CONFIG.PROPERTY_KEY,
    JSON.stringify(visibleKeys)
  );
  return getDashboardCardVisibility();
}

/** Dashboard API: returns the editable employee email directory. */
function getDashboardEmailDirectory() {
  const context = assertDashboardEmailAdmin_();
  const storedRows = readEmailDirectory_(context.spreadsheet);
  const rows = mergeDirectoryWithSiteOwners_(context.spreadsheet, storedRows);
  return {
    ok: true,
    userEmail: context.userEmail,
    sheetName: REMINDER_CONFIG.DIRECTORY_SHEET,
    sourceOwnerCount: rows.filter(row => row.fromKpiSheets).length,
    rows: rows
  };
}

/** Dashboard API: validates and replaces the managed directory rows. */
function saveDashboardEmailDirectory(entries) {
  const context = assertDashboardEmailAdmin_();
  if (!Array.isArray(entries)) throw new Error('The email directory payload is invalid.');
  if (entries.length > 500) throw new Error('The email directory is limited to 500 entries.');

  const cleaned = [];
  const seenNames = {};
  entries.forEach((entry, index) => {
    const name = cleanCellText_(entry && entry.name);
    const email = cleanCellText_(entry && entry.email).toLowerCase();
    const active = !!(entry && entry.active) && !!email;
    const cc = !!(entry && entry.cc) && !!email;

    if (!name && !email) return;
    if (!name) throw new Error('Row ' + (index + 1) + ': employee name is required.');
    if (email && !isValidEmail_(email)) throw new Error('Row ' + (index + 1) + ': enter a valid email address or leave it blank.');

    const nameKey = normalizeText_(name);
    if (seenNames[nameKey]) {
      throw new Error('Duplicate employee name: ' + name + '. Each KPI owner must appear once.');
    }
    seenNames[nameKey] = true;
    cleaned.push({ name: name, email: email, active: active, cc: cc });
  });

  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    const sheet = ensureEmailDirectorySheet_(context.spreadsheet);
    const existingRows = Math.max(0, sheet.getLastRow() - 1);
    if (existingRows) sheet.getRange(2, 1, existingRows, REMINDER_CONFIG.DIRECTORY_HEADERS.length).clearContent();

    if (cleaned.length) {
      const now = new Date();
      const values = cleaned.map(entry => [
        entry.name,
        entry.email,
        entry.active,
        entry.cc,
        now,
        context.userEmail
      ]);
      const range = sheet.getRange(2, 1, values.length, REMINDER_CONFIG.DIRECTORY_HEADERS.length);
      sheet.getRange(2, 3, values.length, 2).insertCheckboxes();
      range.setValues(values);
      sheet.getRange(2, 5, values.length, 1).setNumberFormat('dd mmm yyyy hh:mm');
    }

    SpreadsheetApp.flush();
  } finally {
    lock.releaseLock();
  }

  return getDashboardEmailDirectory();
}

function assertDashboardEmailAdmin_() {
  const ss = getSpreadsheet_();
  const userEmail = String(Session.getActiveUser().getEmail() || '').trim().toLowerCase();
  if (!userEmail) {
    throw new Error(
      'Your signed-in email is not available. Deploy this web app as "User accessing the web app" ' +
      'and restrict access to your organization before managing the email directory.'
    );
  }

  let ownerEmail = '';
  let editorEmails = [];
  try {
    const owner = ss.getOwner();
    ownerEmail = owner ? String(owner.getEmail() || '').trim().toLowerCase() : '';
    editorEmails = ss.getEditors().map(user => String(user.getEmail() || '').trim().toLowerCase());
  } catch (err) {
    throw new Error('Could not verify spreadsheet editor access for ' + userEmail + '.');
  }

  if (userEmail !== ownerEmail && !editorEmails.includes(userEmail)) {
    throw new Error('Only the spreadsheet owner or an editor can manage KPI email addresses.');
  }
  return { spreadsheet: ss, userEmail: userEmail };
}

function ensureEmailDirectorySheet_(ss) {
  let sheet = ss.getSheetByName(REMINDER_CONFIG.DIRECTORY_SHEET);
  if (!sheet) sheet = ss.insertSheet(REMINDER_CONFIG.DIRECTORY_SHEET);

  const headerRange = sheet.getRange(1, 1, 1, REMINDER_CONFIG.DIRECTORY_HEADERS.length);
  const currentHeaders = headerRange.getValues()[0].map(cleanCellText_);
  if (currentHeaders.join('|') !== REMINDER_CONFIG.DIRECTORY_HEADERS.join('|')) {
    headerRange.setValues([REMINDER_CONFIG.DIRECTORY_HEADERS]);
  }

  headerRange
    .setBackground('#003b76')
    .setFontColor('#ffffff')
    .setFontWeight('bold');
  sheet.setFrozenRows(1);
  sheet.setColumnWidth(1, 210);
  sheet.setColumnWidth(2, 260);
  sheet.setColumnWidth(3, 90);
  sheet.setColumnWidth(4, 155);
  sheet.setColumnWidth(5, 160);
  sheet.setColumnWidth(6, 230);
  return sheet;
}

function readEmailDirectory_(ss) {
  const sheet = ss.getSheetByName(REMINDER_CONFIG.DIRECTORY_SHEET);
  if (!sheet || sheet.getLastRow() < 2) return [];

  return sheet.getRange(2, 1, sheet.getLastRow() - 1, REMINDER_CONFIG.DIRECTORY_HEADERS.length)
    .getValues()
    .map(row => ({
      name: cleanCellText_(row[0]),
      email: cleanCellText_(row[1]).toLowerCase(),
      active: toBoolean_(row[2]),
      cc: toBoolean_(row[3]),
      updatedAt: row[4] instanceof Date ? row[4].toISOString() : cleanCellText_(row[4]),
      updatedBy: cleanCellText_(row[5])
    }))
    .filter(entry => entry.name || entry.email);
}

function getEmailDirectoryMap_(entries) {
  const map = {};
  (entries || []).forEach(entry => {
    if (!entry.active || !entry.name || !isValidEmail_(entry.email)) return;
    map[normalizeText_(entry.name)] = entry.email;
  });
  return map;
}

/** Discovers KPI Responsible names from every configured site tab. */
function collectKpiOwnersBySite_(ss) {
  const ownerMap = {};
  const siteOrder = {};
  CONFIG.SITE_SHEETS.forEach((cfg, index) => { siteOrder[cfg.site] = index; });

  CONFIG.SITE_SHEETS.forEach(cfg => {
    const sheet = findSheet_(ss, cfg.sheet);
    if (!sheet) return;
    let site;
    try {
      site = parseSiteSheet_(sheet, cfg);
    } catch (err) {
      return;
    }
    site.metrics.forEach(metric => {
      metric.owners.forEach(ownerName => {
        const key = normalizeText_(ownerName);
        if (!key) return;
        if (!ownerMap[key]) ownerMap[key] = { name: ownerName, sites: [], siteCodes: [] };
        if (!ownerMap[key].sites.includes(cfg.site)) ownerMap[key].sites.push(cfg.site);
        if (!ownerMap[key].siteCodes.includes(cfg.code)) ownerMap[key].siteCodes.push(cfg.code);
      });
    });
  });

  return Object.keys(ownerMap)
    .map(key => ownerMap[key])
    .sort((a, b) => {
      const siteA = Math.min.apply(null, a.sites.map(site => siteOrder[site]));
      const siteB = Math.min.apply(null, b.sites.map(site => siteOrder[site]));
      return siteA - siteB || a.name.localeCompare(b.name);
    });
}

/** Adds every discovered site owner without overwriting previously saved emails. */
function mergeDirectoryWithSiteOwners_(ss, storedRows) {
  const storedMap = {};
  (storedRows || []).forEach(row => { if (row.name) storedMap[normalizeText_(row.name)] = row; });
  const used = {};
  const merged = collectKpiOwnersBySite_(ss).map(owner => {
    const key = normalizeText_(owner.name);
    const stored = storedMap[key] || {};
    used[key] = true;
    return {
      name: owner.name,
      email: stored.email || '',
      active: stored.email ? stored.active !== false : false,
      cc: stored.email ? !!stored.cc : false,
      sites: owner.sites,
      siteCodes: owner.siteCodes,
      fromKpiSheets: true,
      updatedAt: stored.updatedAt || '',
      updatedBy: stored.updatedBy || ''
    };
  });

  (storedRows || []).forEach(row => {
    const key = normalizeText_(row.name);
    if (!key || used[key]) return;
    merged.push({
      name: row.name,
      email: row.email,
      active: row.active,
      cc: row.cc,
      sites: ['Manual / not currently assigned'],
      siteCodes: [],
      fromKpiSheets: false,
      updatedAt: row.updatedAt || '',
      updatedBy: row.updatedBy || ''
    });
  });
  return merged;
}

/** Dashboard API: returns every eligible KPI grouped by site with its monitor checkbox. */
function getDashboardReminderChecklist() {
  const context = assertDashboardEmailAdmin_();
  const rows = syncReminderChecklist_(context.spreadsheet, null, context.userEmail);
  return {
    rows: rows,
