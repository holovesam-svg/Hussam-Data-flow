/** One-time authorization helper; it checks quota but sends no email. */
function authorizeKpiEmailService() {
  const quota = MailApp.getRemainingDailyQuota();
  const message = 'Email service authorized. Remaining daily recipient quota: ' + quota + '. No email was sent.';
  console.log(message);
