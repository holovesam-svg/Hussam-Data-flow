/** Creates a dedicated, branded one-click launcher sheet without touching KPI source tabs. */
function installDashboardLauncher() {
  const ss = getSpreadsheet_();
  let sheet = ss.getSheetByName(LAUNCHER_CONFIG.SHEET_NAME);

  if (!sheet) {
    sheet = ss.insertSheet(LAUNCHER_CONFIG.SHEET_NAME, 0);
    sheet.addDeveloperMetadata(LAUNCHER_CONFIG.METADATA_KEY, LAUNCHER_CONFIG.METADATA_VALUE);
  } else {
    const isManagedLauncher = sheet.getDeveloperMetadata().some(metadata =>
      metadata.getKey() === LAUNCHER_CONFIG.METADATA_KEY &&
      metadata.getValue() === LAUNCHER_CONFIG.METADATA_VALUE
    );
    if (!isManagedLauncher) {
      throw new Error(
        'A sheet named "' + LAUNCHER_CONFIG.SHEET_NAME + '" already exists and was not created by this dashboard. ' +
        'Rename that sheet, then run this setup again.'
      );
    }
  }

  const canvas = sheet.getRange('A1:N24');
  canvas.breakApart();
  canvas.clear();
  canvas.setBackground('#edf8fd').setFontFamily('Arial').setFontColor('#092947');
  sheet.setHiddenGridlines(true);
  sheet.setTabColor('#00a0e1');

  for (let column = 1; column <= 14; column++) sheet.setColumnWidth(column, 86);
  for (let row = 1; row <= 24; row++) sheet.setRowHeight(row, 34);
  sheet.setRowHeights(8, 5, 42);

  sheet.getRange('B2:M3').merge()
    .setValue('ALAR HSE KPI DASHBOARD')
    .setFontSize(24).setFontWeight('bold').setFontColor('#003b76')
    .setHorizontalAlignment('center').setVerticalAlignment('middle');

  sheet.getRange('B4:M5').merge()
    .setValue('Live executive visibility across all operational sites')
    .setFontSize(12).setFontColor('#587187')
    .setHorizontalAlignment('center').setVerticalAlignment('top');

  sheet.getRange('C7:L13').merge()
    .setBackground('#ffffff')
    .setBorder(true, true, true, true, false, false, '#d8eaf4', SpreadsheetApp.BorderStyle.SOLID);

  sheet.getImages().forEach(image => {
    if (image.getAltTextTitle() === 'ALAR HSE Dashboard Launcher') image.remove();
  });

  if (!LAUNCHER_BUTTON_PNG_BASE64) {
    throw new Error('The embedded dashboard launcher button is missing from Code.gs.');
  }

  const buttonBlob = Utilities.newBlob(
    Utilities.base64Decode(LAUNCHER_BUTTON_PNG_BASE64),
    'image/png',
    'alar-hse-dashboard-launcher.png'
  );

  sheet.insertImage(buttonBlob, 4, 8)
    .setWidth(690)
    .setHeight(170)
    .setAltTextTitle('ALAR HSE Dashboard Launcher')
    .setAltTextDescription('Click to open the live ALAR HSE KPI Dashboard inside Google Sheets.')
    .assignScript('openDashboardDialog');

  const webAppUrl = getStoredWebAppUrl_();
  const fullScreenRange = sheet.getRange('D16:K17').merge()
    .setBackground('#003b76')
    .setFontColor('#ffffff')
    .setFontSize(13)
    .setFontWeight('bold')
    .setHorizontalAlignment('center')
    .setVerticalAlignment('middle');

  if (webAppUrl) {
    const safeFormulaUrl = webAppUrl.replace(/"/g, '""');
    fullScreenRange.setFormula('=HYPERLINK("' + safeFormulaUrl + '","OPEN FULL-SCREEN DASHBOARD ↗")');
  } else {
    fullScreenRange.setValue('SAVE THE WEB APP /exec URL: HSE Dashboard → Show Web App URL');
  }

  sheet.getRange('C20:L21').merge()
    .setValue('Click the large dashboard button for the in-Sheets view, or use the full-screen link for management presentations.')
    .setFontSize(10).setFontColor('#587187')
    .setHorizontalAlignment('center').setVerticalAlignment('middle').setWrap(true);

  sheet.activate();
  buildDashboardMenu_();
  ss.toast('HSE Dashboard launcher is ready. Click the large blue button.', 'Dashboard installed', 8);
  return { ok: true, sheetName: sheet.getName(), webAppUrl: webAppUrl || '' };
}

