/** Manual, confirmed send. It may resend even if a scheduled reminder was already sent. */
function sendMissingKpiRemindersNow() {
  const ui = SpreadsheetApp.getUi();
  const audit = collectMissingKpisForLastCompletedMonth_();
  const deliverable = audit.owners.filter(owner => owner.email && owner.items.length);

  if (!deliverable.length) {
    ui.alert(
      'No reminders can be sent. Either all monitored KPIs are complete or no matching active employee emails are saved in the dashboard Email Directory.'
    );
    return audit;
  }

  const response = ui.alert(
    'Send reminder emails directly from this Sheet?',
    'One consolidated email will be sent to each listed KPI owner.\n\n' +
      'Recipients: ' + deliverable.map(owner => owner.name + ' <' + owner.email + '>').join(', ') + '\n' +
      'CC: ' + ((audit.ccEmails || []).join(', ') || 'None') + '\n' +
      'Reporting period: ' + reminderPeriodLabel_(audit) + '\n' +
      'Total emails: ' + deliverable.length + '\n' +
      'Total missing KPI entries: ' +
      deliverable.reduce((sum, owner) => sum + owner.items.length, 0) +
      '\n\nChoose Yes to send now, or No to cancel.',
    ui.ButtonSet.YES_NO
  );

  if (response !== ui.Button.YES) return { cancelled: true, audit: audit };

  const result = sendMissingKpiReminderEmails_(audit, true);
  ui.alert('KPI reminders sent', formatSendResult_(result), ui.ButtonSet.OK);
  return result;
}

/** Creates one daily trigger. The function itself stays silent on day 1 of each month. */
function enableDailyKpiReminders() {
  validateReminderDirectory_();
  validateReminderChecklist_();
  deleteReminderTriggers_();
  createDailyReminderTrigger_();

  SpreadsheetApp.getUi().alert(
    'Daily KPI reminders enabled. Beginning on day ' + REMINDER_CONFIG.START_DAY_OF_MONTH +
    ' of each month, January through the previous month will be checked daily at approximately ' +
    REMINDER_CONFIG.TRIGGER_HOUR + ':00 (' + Session.getScriptTimeZone() + '). ' +
    'Each owner receives one consolidated email per day until all selected KPIs are filled.'
  );
}

function disableDailyKpiReminders() {
  const removed = deleteReminderTriggers_();
  SpreadsheetApp.getUi().alert(
    removed ? 'Daily KPI reminders disabled.' : 'No daily KPI reminder trigger was active.'
  );
}

function createDailyReminderTrigger_() {
  return ScriptApp.newTrigger('runDailyKpiReminderCheck')
    .timeBased()
    .everyDays(1)
    .atHour(REMINDER_CONFIG.TRIGGER_HOUR)
    .inTimezone(Session.getScriptTimeZone())
    .create();
}

function isDailyReminderEnabled_() {
  return ScriptApp.getProjectTriggers().some(trigger =>
    ['runDailyKpiReminderCheck', 'runMonthlyKpiReminderCheck'].includes(trigger.getHandlerFunction())
  );
}

/** Trigger entry point. Sends at most once per owner per day, starting on day 2. */
function runDailyKpiReminderCheck() {
  const day = Number(Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'd'));
  if (day < REMINDER_CONFIG.START_DAY_OF_MONTH) {
    return { skipped: true, reason: 'Reminder checking starts on day ' + REMINDER_CONFIG.START_DAY_OF_MONTH + '.' };
  }
  validateReminderDirectory_();
  validateReminderChecklist_();
  const audit = collectMissingKpisForLastCompletedMonth_();
  return sendMissingKpiReminderEmails_(audit, false);
}

/** Compatibility aliases for anyone who previously selected the old monthly functions. */
function enableMonthlyKpiReminders() { return enableDailyKpiReminders(); }
function disableMonthlyKpiReminders() { return disableDailyKpiReminders(); }
function runMonthlyKpiReminderCheck() { return runDailyKpiReminderCheck(); }

function collectMissingKpisForLastCompletedMonth_() {
  const throughMonthIndex = getLastCompletedMonthIndex_();
  if (throughMonthIndex < 0) {
    throw new Error('There is no completed month within dashboard year ' + CONFIG.YEAR + '.');
  }

  const ss = getSpreadsheet_();
  const directoryEntries = readEmailDirectory_(ss);
  const directoryMap = getEmailDirectoryMap_(directoryEntries);
  const checklistRows = readReminderChecklist_(ss);
  const selectionMap = getReminderSelectionMap_(checklistRows);
  const selectedCount = checklistRows.filter(row => row.monitor).length;
  const ccEmails = directoryEntries
    .filter(entry => entry.active && entry.cc && isValidEmail_(entry.email))
    .map(entry => entry.email);
  const ownerMap = {};
  const unassigned = [];
  const warnings = [];
  if (!checklistRows.length) warnings.push('The KPI reminder checklist has not been initialized.');
  else if (!selectedCount) warnings.push('No KPI is selected for daily monitoring.');

  CONFIG.SITE_SHEETS.forEach(cfg => {
    const sheet = findSheet_(ss, cfg.sheet);
    if (!sheet) {
      warnings.push('Missing source sheet: ' + cfg.sheet);
      return;
    }

    let site;
    try {
      site = parseSiteSheet_(sheet, cfg);
    } catch (err) {
      warnings.push(cfg.site + ': ' + (err && err.message ? err.message : String(err)));
      return;
    }

    site.metrics.forEach(metric => {
      if (!shouldMonitorMetric_(metric, selectionMap)) return;

      for (let monthIndex = 0; monthIndex <= throughMonthIndex; monthIndex++) {
        if (metric.monthly[monthIndex] !== null) continue; // Zero is a valid reported value.

        const item = {
          site: metric.site,
          siteCode: metric.siteCode,
          sheet: metric.sheet,
          row: metric.row,
          label: metric.label,
          category: metric.category,
          kind: metric.kind,
          monthIndex: monthIndex,
          monthName: CONFIG.MONTHS[monthIndex]
        };

        if (!metric.owners.length) {
          unassigned.push(item);
          continue;
        }

        metric.owners.forEach(ownerName => {
          const key = normalizeText_(ownerName);
          if (!ownerMap[key]) {
            ownerMap[key] = {
              name: ownerName,
              email: findOwnerEmail_(ownerName, directoryMap),
              items: []
            };
          }
          ownerMap[key].items.push(item);
        });
      }
    });
  });

  Object.keys(ownerMap).forEach(key => {
    ownerMap[key].items.sort(compareMissingKpiItems_);
  });
  unassigned.sort(compareMissingKpiItems_);

  const owners = Object.keys(ownerMap)
    .map(key => ownerMap[key])
    .sort((a, b) => a.name.localeCompare(b.name));

  const audit = {
    year: CONFIG.YEAR,
    monthIndex: throughMonthIndex,
    monthName: CONFIG.MONTHS[throughMonthIndex],
    fromMonthIndex: 0,
    fromMonthName: CONFIG.MONTHS[0],
    throughMonthIndex: throughMonthIndex,
    monthsChecked: throughMonthIndex + 1,
    spreadsheetName: ss.getName(),
    spreadsheetUrl: ss.getUrl(),
    ccEmails: Array.from(new Set(ccEmails)),
    owners: owners,
    unassigned: unassigned,
    warnings: warnings,
    selectedCount: selectedCount,
    missingCount: owners.reduce((sum, owner) => sum + owner.items.length, 0) + unassigned.length,
    generatedAt: new Date().toISOString()
  };
  audit.periodLabel = reminderPeriodLabel_(audit);
  return audit;
}

function reminderPeriodLabel_(audit) {
  const year = (audit && audit.year) || CONFIG.YEAR;
  const throughIndex = Number(audit && (audit.throughMonthIndex != null ? audit.throughMonthIndex : audit.monthIndex));
  if (!isFinite(throughIndex) || throughIndex < 0) return String(year);
  if (throughIndex === 0) return CONFIG.MONTHS[0] + ' ' + year;
  return CONFIG.MONTHS[0] + '–' + CONFIG.MONTHS[throughIndex] + ' ' + year;
}

function compareMissingKpiItems_(a, b) {
  const monthA = Number(a && a.monthIndex);
  const monthB = Number(b && b.monthIndex);
  if (monthA !== monthB) return (isFinite(monthA) ? monthA : 99) - (isFinite(monthB) ? monthB : 99);
  const site = String((a && a.site) || '').localeCompare(String((b && b.site) || ''));
  if (site) return site;
  return String((a && (a.label || a.kpi)) || '').localeCompare(String((b && (b.label || b.kpi)) || ''));
}

function shouldMonitorMetric_(metric, selectionMap) {
  if (!isEligibleForReminderChecklist_(metric)) return false;
  return !!(selectionMap && selectionMap[metricReminderKey_(metric)]);
}

function getLastCompletedMonthIndex_() {
  const parts = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy,M,d')
    .split(',')
    .map(Number);
  const currentYear = parts[0];
  const currentMonthOneBased = parts[1];

  if (CONFIG.YEAR < currentYear) return 11;
  if (CONFIG.YEAR > currentYear) return -1;
  return currentMonthOneBased - 2;
}

function findOwnerEmail_(ownerName, directoryMap) {
  const email = directoryMap && directoryMap[normalizeText_(ownerName)];
  return isValidEmail_(email) ? email : '';
}

function validateReminderDirectory_() {
  const validEmails = readEmailDirectory_(getSpreadsheet_())
    .filter(entry => entry.active)
    .map(entry => entry.email)
    .filter(isValidEmail_);
  if (!validEmails.length) {
    throw new Error(
      'Add and activate employee email addresses in the dashboard Email Directory before enabling reminders.'
    );
  }
}

function validateReminderChecklist_() {
  const rows = readReminderChecklist_(getSpreadsheet_());
  if (!rows.some(row => row.monitor)) {
    throw new Error(
      'No KPI is selected for monitoring. Open the dashboard KPI checklist (or run initializeKpiReminderChecklist) ' +
      'and check at least one required KPI before enabling reminders.'
    );
  }
}

function isValidEmail_(email) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(email || '').trim());
}

function sendMissingKpiReminderEmails_(audit, forceSend) {
  const properties = PropertiesService.getScriptProperties();
  const cc = (audit.ccEmails || []).filter(isValidEmail_).join(',');
  const result = { sent: [], skipped: [], noEmail: [], month: audit.monthName, year: audit.year };

  audit.owners.forEach(owner => {
    if (!owner.items.length) return;
    if (!owner.email) {
      result.noEmail.push(owner.name);
      return;
    }

    const sentKey = reminderSentKey_(audit, owner);
    if (!forceSend && properties.getProperty(sentKey)) {
      result.skipped.push(owner.name);
      return;
    }

    const subject = reminderEmailSubject_(audit);
    const htmlBody = buildReminderEmailHtml_(audit, owner);
    const plainBody = buildReminderEmailText_(audit, owner);
    const message = {
      to: owner.email,
      subject: subject,
      body: plainBody,
      htmlBody: htmlBody,
      name: REMINDER_CONFIG.SENDER_NAME
    };
    if (cc) message.cc = cc;

    MailApp.sendEmail(message);
    properties.setProperty(sentKey, new Date().toISOString());
    result.sent.push(owner.name);
  });

  return result;
}

function reminderEmailSubject_(audit) {
  return '[Action Required] Missing HSE KPI entries — ' + reminderPeriodLabel_(audit);
}

