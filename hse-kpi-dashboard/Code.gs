/**
 * Dashboard API: exact reminder preview. Never sends email.
 * Returns To, CC, subject and the same HTML/text bodies used by the live send.
 */
function getDashboardReminderEmailPreview() {
  const context = assertDashboardEmailAdmin_();
  const audit = collectMissingKpisForLastCompletedMonth_();
  return serializeReminderPreview_(audit, context.userEmail);
}

/**
 * Dashboard API: send the current missing-KPI reminders immediately.
 * Requires confirmed === true from the dashboard confirmation step.
 * Manual send is forced and may resend on the same day.
 */
function sendDashboardReminderEmailsNow(confirmed) {
  assertDashboardEmailAdmin_();
  if (confirmed !== true) {
    throw new Error('Sending was not confirmed. Preview the emails first, then confirm Send now.');
  }

  const audit = collectMissingKpisForLastCompletedMonth_();
  const deliverable = audit.owners.filter(owner => owner.email && owner.items.length);
  if (!deliverable.length) {
    return {
      ok: false,
      sent: false,
      month: audit.monthName,
      year: audit.year,
      ccEmails: audit.ccEmails || [],
      sentNames: [],
      skipped: [],
      noEmail: audit.owners.filter(owner => !owner.email && owner.items.length).map(owner => owner.name),
      remainingDailyQuota: MailApp.getRemainingDailyQuota(),
      message: 'No reminders can be sent. Either all monitored KPIs are complete or no matching active employee emails are saved in the dashboard Email Directory.'
    };
  }

  const result = sendMissingKpiReminderEmails_(audit, true);
  return {
    ok: true,
    sent: true,
    month: result.month,
    year: result.year,
    ccEmails: audit.ccEmails || [],
    sentNames: result.sent,
    skipped: result.skipped,
    noEmail: result.noEmail,
    remainingDailyQuota: MailApp.getRemainingDailyQuota(),
    message: 'Sent ' + result.sent.length + ' reminder email(s) for ' +
      reminderPeriodLabel_(audit) + '.'
  };
}

/**
 * Dashboard API: January-through-last-month required-KPI completeness for Overview.
 * Never sends email and never returns email addresses.
 */
function getDashboardOverviewCompleteness() {
  let canSend = false;
  try {
    assertDashboardEmailAdmin_();
    canSend = true;
  } catch (err) {
    canSend = false;
  }

  try {
    const audit = collectMissingKpisForLastCompletedMonth_();
    return serializeOverviewCompleteness_(audit, canSend);
  } catch (err) {
    return {
      ok: false,
      canSend: canSend,
      year: CONFIG.YEAR,
      monthName: '',
      monthIndex: -1,
      periodLabel: '',
      fromMonthName: '',
      monthsChecked: 0,
      expectedCount: 0,
      selectedCount: 0,
      missingCount: 0,
      completeCount: 0,
      completenessPct: 0,
      incompleteSiteCount: 0,
      ownersWithoutEmailCount: 0,
      sites: CONFIG.SITE_SHEETS.map(cfg => ({
        site: cfg.site,
        code: cfg.code,
        selectedCount: 0,
        missingCount: 0,
        completeCount: 0,
        status: 'unavailable'
      })),
      missingItems: [],
      warnings: [err && err.message ? err.message : String(err || 'Completeness is unavailable.')]
    };
  }
}

function serializeOverviewCompleteness_(audit, canSend) {
  const checklistRows = readReminderChecklist_(getSpreadsheet_());
  const selectedBySite = {};
  CONFIG.SITE_SHEETS.forEach(cfg => {
    selectedBySite[cfg.site] = 0;
  });
  checklistRows.forEach(row => {
    if (row.monitor) selectedBySite[row.site] = (selectedBySite[row.site] || 0) + 1;
  });

  const missingItems = [];
  (audit.owners || []).forEach(owner => {
    (owner.items || []).forEach(item => {
      missingItems.push({
        month: item.monthName || '',
        monthIndex: item.monthIndex,
        site: item.site,
        kpi: item.label,
        owner: owner.name || '',
        hasEmail: !!owner.email
      });
    });
  });
  (audit.unassigned || []).forEach(item => {
    missingItems.push({
      month: item.monthName || '',
      monthIndex: item.monthIndex,
      site: item.site,
      kpi: item.label,
      owner: '',
      hasEmail: false
    });
  });
  missingItems.sort(compareMissingKpiItems_);

  const missingBySite = {};
  missingItems.forEach(item => {
    missingBySite[item.site] = (missingBySite[item.site] || 0) + 1;
  });

  const monthsChecked = Number(audit.monthsChecked) || 0;
  const sites = CONFIG.SITE_SHEETS.map(cfg => {
    const selectedCount = selectedBySite[cfg.site] || 0;
    const expectedCount = selectedCount * monthsChecked;
    const missingCount = missingBySite[cfg.site] || 0;
    let status = 'not-monitored';
    if (selectedCount && !missingCount) status = 'complete';
    else if (missingCount) status = 'missing';
    return {
      site: cfg.site,
      code: cfg.code,
      selectedCount: selectedCount,
      expectedCount: expectedCount,
      missingCount: missingCount,
      completeCount: Math.max(0, expectedCount - missingCount),
      status: status
    };
  });

  const selectedCount = audit.selectedCount || 0;
  const expectedCount = selectedCount * monthsChecked;
  const missingCount = audit.missingCount || 0;
  const completeCount = Math.max(0, expectedCount - missingCount);
  const ownersWithoutEmail = [];
  missingItems.forEach(item => {
    if (item.owner && !item.hasEmail && ownersWithoutEmail.indexOf(item.owner) < 0) {
      ownersWithoutEmail.push(item.owner);
    }
  });

  return {
    ok: true,
    canSend: !!canSend,
    year: audit.year,
    monthName: audit.monthName,
    monthIndex: audit.monthIndex,
    periodLabel: reminderPeriodLabel_(audit),
    fromMonthName: audit.fromMonthName || CONFIG.MONTHS[0],
    monthsChecked: monthsChecked,
    expectedCount: expectedCount,
    selectedCount: selectedCount,
    missingCount: missingCount,
    completeCount: completeCount,
    completenessPct: expectedCount ? Math.round((completeCount / expectedCount) * 100) : 0,
    incompleteSiteCount: sites.filter(site => site.missingCount > 0).length,
    ownersWithoutEmailCount: ownersWithoutEmail.length,
    sites: sites,
    missingItems: missingItems,
    warnings: audit.warnings || []
  };
}

function serializeReminderPreview_(audit, userEmail) {
  const ccEmails = (audit.ccEmails || []).filter(isValidEmail_);
  const deliverable = audit.owners.filter(owner => owner.email && owner.items.length);
  const withoutEmail = audit.owners.filter(owner => !owner.email && owner.items.length);
  const subject = reminderEmailSubject_(audit);

  return {
    ok: true,
    previewOnly: true,
    sent: false,
    userEmail: userEmail || '',
    year: audit.year,
    monthName: audit.monthName,
    monthIndex: audit.monthIndex,
    periodLabel: reminderPeriodLabel_(audit),
    fromMonthName: audit.fromMonthName || CONFIG.MONTHS[0],
    monthsChecked: audit.monthsChecked || 0,
    spreadsheetName: audit.spreadsheetName,
    spreadsheetUrl: audit.spreadsheetUrl,
    selectedCount: audit.selectedCount,
    missingCount: audit.missingCount,
    ccEmails: ccEmails,
    warnings: audit.warnings || [],
    emails: deliverable.map(owner => ({
      ownerName: owner.name,
      to: owner.email,
      cc: ccEmails.slice(),
      subject: subject,
      htmlBody: buildReminderEmailHtml_(audit, owner),
      textBody: buildReminderEmailText_(audit, owner),
      missingCount: owner.items.length,
      items: owner.items.map(item => ({
        month: item.monthName || '',
        monthIndex: item.monthIndex,
        site: item.site,
        label: item.label,
        category: item.category,
        sheet: item.sheet,
        row: item.row
      }))
    })),
    withoutEmail: withoutEmail.map(owner => ({
      name: owner.name,
      missingCount: owner.items.length
    })),
    unassigned: (audit.unassigned || []).map(item => ({
      month: item.monthName || '',
      site: item.site,
      label: item.label,
      sheet: item.sheet,
      row: item.row
    })),
    generatedAt: audit.generatedAt
  };
}

/** Dashboard API: enables or disables the daily time trigger. */
function setDashboardDailyReminderState(enabled) {
  assertDashboardEmailAdmin_();
  const shouldEnable = !!enabled;
  if (shouldEnable) {
    validateReminderDirectory_();
    validateReminderChecklist_();
  }
  deleteReminderTriggers_();
  if (shouldEnable) createDailyReminderTrigger_();
  return {
    dailyEnabled: shouldEnable,
    startDay: REMINDER_CONFIG.START_DAY_OF_MONTH,
    triggerHour: REMINDER_CONFIG.TRIGGER_HOUR
  };
}

/** Dashboard API: saves only checkbox choices; KPI identity always comes from source tabs. */
function saveDashboardReminderChecklist(entries) {
  const context = assertDashboardEmailAdmin_();
  if (!Array.isArray(entries)) throw new Error('The KPI checklist payload is invalid.');
  if (entries.length > 1000) throw new Error('The KPI checklist is limited to 1,000 entries.');

  const selections = {};
  entries.forEach((entry, index) => {
    const key = cleanCellText_(entry && entry.key);
    if (!key) throw new Error('Checklist row ' + (index + 1) + ' has no KPI key. Refresh the list and try again.');
    selections[key] = !!entry.monitor;
  });

  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    syncReminderChecklist_(context.spreadsheet, selections, context.userEmail);
    SpreadsheetApp.flush();
  } finally {
    lock.releaseLock();
  }
  return getDashboardReminderChecklist();
}

/** Sheets-menu helper: creates or refreshes the site-by-site checkbox list. */
function initializeKpiReminderChecklist() {
  const context = assertDashboardEmailAdmin_();
  const rows = syncReminderChecklist_(context.spreadsheet, null, context.userEmail);
  const sheet = context.spreadsheet.getSheetByName(REMINDER_CONFIG.CHECKLIST_SHEET);
  if (sheet) context.spreadsheet.setActiveSheet(sheet);
  SpreadsheetApp.getUi().alert(
    'KPI reminder checklist ready',
    rows.length + ' eligible KPI rows are listed by site. Check only the KPIs that must be reported every month. ' +
      'Unchecked KPIs will never trigger an email.',
    SpreadsheetApp.getUi().ButtonSet.OK
  );
  return rows;
}

function syncReminderChecklist_(ss, overrideSelections, updatedBy) {
  const existing = getReminderSelectionMap_(readReminderChecklist_(ss));
  const selections = overrideSelections || existing;
  const now = new Date();
  const rows = [];

  CONFIG.SITE_SHEETS.forEach(cfg => {
    const source = findSheet_(ss, cfg.sheet);
    if (!source) return;
    const site = parseSiteSheet_(source, cfg);
    site.metrics.forEach(metric => {
      if (!isEligibleForReminderChecklist_(metric)) return;
      const key = metricReminderKey_(metric);
      rows.push({
        key: key,
        monitor: Object.prototype.hasOwnProperty.call(selections, key) ? !!selections[key] : false,
        site: metric.site,
        siteCode: metric.siteCode,
        label: metric.label,
        owners: metric.owners.join(', '),
        category: metric.category,
        sheet: metric.sheet,
        row: metric.row,
        updatedAt: now.toISOString(),
        updatedBy: updatedBy || ''
      });
    });
  });

  rows.sort((a, b) => a.site.localeCompare(b.site) || a.row - b.row || a.label.localeCompare(b.label));
  const sheet = ensureReminderChecklistSheet_(ss);
  const oldRows = Math.max(0, sheet.getLastRow() - 1);
  if (oldRows) {
    sheet.getRange(2, 1, oldRows, REMINDER_CONFIG.CHECKLIST_HEADERS.length)
      .clearContent()
      .clearDataValidations();
  }

  if (rows.length) {
    const values = rows.map(item => [
      item.monitor, item.site, item.label, item.owners, item.category,
      item.sheet, item.row, item.key, now, updatedBy || ''
    ]);
    const range = sheet.getRange(2, 1, values.length, REMINDER_CONFIG.CHECKLIST_HEADERS.length);
    sheet.getRange(2, 1, values.length, 1).insertCheckboxes();
    range.setValues(values);
    sheet.getRange(2, 9, values.length, 1).setNumberFormat('dd mmm yyyy hh:mm');
  }
  const filter = sheet.getFilter();
  if (filter) filter.remove();
  if (rows.length) {
    sheet.getRange(1, 1, rows.length + 1, REMINDER_CONFIG.CHECKLIST_HEADERS.length).createFilter();
  }
  return rows;
}

function ensureReminderChecklistSheet_(ss) {
  let sheet = ss.getSheetByName(REMINDER_CONFIG.CHECKLIST_SHEET);
  if (!sheet) sheet = ss.insertSheet(REMINDER_CONFIG.CHECKLIST_SHEET);
  const headers = REMINDER_CONFIG.CHECKLIST_HEADERS;
  const headerRange = sheet.getRange(1, 1, 1, headers.length);
  if (headerRange.getValues()[0].map(cleanCellText_).join('|') !== headers.join('|')) {
    headerRange.setValues([headers]);
  }
  headerRange.setBackground('#003b76').setFontColor('#ffffff').setFontWeight('bold');
  sheet.setFrozenRows(1);
  sheet.setColumnWidth(1, 110);
  sheet.setColumnWidth(2, 160);
  sheet.setColumnWidth(3, 340);
  sheet.setColumnWidth(4, 210);
  sheet.setColumnWidth(5, 150);
  sheet.setColumnWidth(6, 180);
  sheet.setColumnWidth(7, 90);
  sheet.setColumnWidth(8, 260);
  sheet.setColumnWidth(9, 160);
  sheet.setColumnWidth(10, 220);
  return sheet;
}

function readReminderChecklist_(ss) {
  const sheet = ss.getSheetByName(REMINDER_CONFIG.CHECKLIST_SHEET);
  if (!sheet || sheet.getLastRow() < 2) return [];
  return sheet.getRange(2, 1, sheet.getLastRow() - 1, REMINDER_CONFIG.CHECKLIST_HEADERS.length)
    .getValues()
    .map(row => ({
      monitor: toBoolean_(row[0]),
      site: cleanCellText_(row[1]),
      label: cleanCellText_(row[2]),
      owners: cleanCellText_(row[3]),
      category: cleanCellText_(row[4]),
      sheet: cleanCellText_(row[5]),
      row: Number(row[6]) || 0,
      key: cleanCellText_(row[7])
    }))
    .filter(row => row.key);
}

function getReminderSelectionMap_(rows) {
  const map = {};
  (rows || []).forEach(row => { if (row.key) map[row.key] = !!row.monitor; });
  return map;
}

function metricReminderKey_(metric) {
  return [metric.siteCode, metric.sheet, metric.row, normalizeText_(metric.label)].join('|');
}

function isEligibleForReminderChecklist_(metric) {
  if (!metric || metric.derived) return false;
  if (REMINDER_CONFIG.EXCLUDED_KINDS.includes(metric.kind)) return false;
  if (REMINDER_CONFIG.EXCLUDED_LABEL_PATTERNS.some(pattern => pattern.test(metric.label))) return false;
  return true;
}

function toBoolean_(value) {
  if (value === true || value === 1) return true;
  return /^(true|yes|y|1|active)$/i.test(cleanCellText_(value));
}

/**
 * Sends one harmless test message from the web dashboard.
 * The recipient must be the signed-in user or an active address saved in the
 * dashboard-managed KPI Email Directory.
 */
function sendDashboardTestEmail(recipient) {
  const email = String(recipient || '').trim().toLowerCase();
  if (!isValidEmail_(email)) throw new Error('Enter a valid email address.');

  const context = assertDashboardEmailAdmin_();
  const activeUserEmail = context.userEmail;
  const ss = context.spreadsheet;
  const configuredEmails = readEmailDirectory_(ss)
    .filter(entry => entry.active && isValidEmail_(entry.email))
    .map(entry => entry.email.toLowerCase());

  const isSelf = activeUserEmail && email === activeUserEmail;
  const isApproved = configuredEmails.includes(email);
  if (!isSelf && !isApproved) {
    throw new Error(
      'This recipient is not active in the dashboard Email Directory. Add it using the settings button, ' +
      'or use the email address of the signed-in Google Workspace user.'
    );
  }

  const sentAt = new Date();
  const sentAtText = Utilities.formatDate(sentAt, Session.getScriptTimeZone(), 'dd MMM yyyy, HH:mm z');
  const subject = '[TEST] ALAR HSE KPI email notification';
  const plainBody =
    'This is a test email from the ALAR HSE KPI Dashboard.\n\n' +
    'Google Sheet: ' + ss.getName() + '\n' +
    'Sent: ' + sentAtText + '\n\n' +
    'The dashboard email connection is working. No KPI reminder was issued.';
  const htmlBody =
    '<div style="font-family:Arial,sans-serif;color:#092947;line-height:1.55;max-width:640px">' +
      '<div style="background:linear-gradient(135deg,#003b76,#006ca8);color:#fff;padding:22px 26px;border-radius:14px 14px 0 0">' +
        '<div style="font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#8edcff">ALAR HSE KPI Dashboard</div>' +
        '<div style="font-size:23px;font-weight:700;margin-top:5px">Test notification successful</div>' +
      '</div>' +
      '<div style="padding:24px 26px;border:1px solid #dceaf3;border-top:0;border-radius:0 0 14px 14px">' +
        '<p>This is a test email from the dashboard. The email connection is working correctly.</p>' +
        '<div style="background:#edf8fd;border-radius:10px;padding:14px 16px;margin:16px 0">' +
          '<strong>Google Sheet:</strong> ' + escapeHtml_(ss.getName()) + '<br>' +
          '<strong>Sent:</strong> ' + escapeHtml_(sentAtText) +
        '</div>' +
        '<p style="font-size:12px;color:#587187">No KPI reminder was issued and no reporting data was changed.</p>' +
      '</div>' +
    '</div>';

  MailApp.sendEmail({
    to: email,
    subject: subject,
    body: plainBody,
    htmlBody: htmlBody,
    name: REMINDER_CONFIG.SENDER_NAME
  });

  return {
    ok: true,
    recipient: email,
    sentAt: sentAt.toISOString(),
    remainingDailyQuota: MailApp.getRemainingDailyQuota()
  };
}

