    '</div>' +
    '<div style="padding:22px 24px;border:1px solid #dceaf3;border-top:0;border-radius:0 0 14px 14px">' +
      '<p>Hello ' + escapeHtml_(owner.name) + ',</p>' +
      '<p>The following KPI entries are still blank from <strong>' + escapeHtml_(period) + '</strong>. ' +
      'Please update the listed entries in the KPI reporting sheet. This daily reminder will stop automatically after the selected KPIs are completed.</p>' +
      '<div style="display:flex;gap:10px;flex-wrap:wrap;margin:16px 0">' +
        '<div style="background:#edf8fd;border:1px solid #cceaf7;border-radius:10px;padding:10px 14px"><div style="font-size:11px;color:#587187;text-transform:uppercase">Reporting period</div><strong>' + escapeHtml_(period) + '</strong></div>' +
        '<div style="background:#fff5df;border:1px solid #f2dba5;border-radius:10px;padding:10px 14px"><div style="font-size:11px;color:#7a5a13;text-transform:uppercase">Missing required KPIs</div><strong>' + owner.items.length + '</strong></div>' +
      '</div>' +
      '<table style="width:100%;border-collapse:collapse;margin:16px 0;font-size:13px">' +
        '<thead><tr style="background:#edf8fd;text-align:left">' +
          '<th style="padding:9px 10px">Month</th><th style="padding:9px 10px">Site</th><th style="padding:9px 10px">KPI</th><th style="padding:9px 10px">Category</th><th style="padding:9px 10px">Source location</th>' +
        '</tr></thead><tbody>' + rows + '</tbody>' +
      '</table>' +
      '<p><a href="' + escapeHtml_(audit.spreadsheetUrl) + '" style="display:inline-block;background:#00a0e1;color:#fff;text-decoration:none;padding:10px 16px;border-radius:9px;font-weight:700">Open KPI reporting sheet</a></p>' +
      '<p style="font-size:12px;color:#587187;margin-top:20px">Automated reminder from ' + escapeHtml_(audit.spreadsheetName) + '. It checks only KPIs selected in the KPI Reminder Checklist, from January through the last completed month, and runs daily from day ' + REMINDER_CONFIG.START_DAY_OF_MONTH + ' of each month.</p>' +
    '</div></div>';
}

function buildReminderEmailText_(audit, owner) {
  const period = reminderPeriodLabel_(audit);
  const lines = owner.items.map(item =>
    '- ' + (item.monthName || '') + ' / ' + item.site + ': ' + item.label + ' (' + item.category + ') — ' + item.sheet + ', row ' + item.row
  );
  return 'Hello ' + owner.name + ',\n\n' +
    'The following KPI entries are still blank from ' + period + ':\n\n' +
    'Missing required KPIs: ' + owner.items.length + '\n\n' +
    lines.join('\n') + '\n\nPlease update the listed entries in the KPI reporting sheet. This daily reminder will stop automatically after the selected KPIs are completed.\n\n' +
    'Open the reporting sheet: ' + audit.spreadsheetUrl + '\n\n' +
    'Automated reminder from ' + audit.spreadsheetName + '. It checks only KPIs selected in the KPI Reminder Checklist, from January through the last completed month, and runs daily from day ' + REMINDER_CONFIG.START_DAY_OF_MONTH + ' of each month.';
}

function buildDetailedReminderPreviewHtml_(audit) {
  const deliverable = audit.owners.filter(owner => owner.email && owner.items.length);
  const withoutEmail = audit.owners.filter(owner => !owner.email && owner.items.length);
  const cc = (audit.ccEmails || []).filter(isValidEmail_).join(', ') || 'None';
  const generated = Utilities.formatDate(new Date(audit.generatedAt), Session.getScriptTimeZone(), 'dd MMM yyyy, HH:mm');
  const subject = reminderEmailSubject_(audit);
  const cards = deliverable.map((owner, index) =>
    '<section class="message">' +
      '<div class="message-head"><div><span>Email ' + (index + 1) + ' of ' + deliverable.length + '</span><h2>' + escapeHtml_(owner.name) + '</h2></div><b>' + owner.items.length + ' missing</b></div>' +
      '<div class="envelope">' +
        '<div><strong>To</strong><span>' + escapeHtml_(owner.email) + '</span></div>' +
        '<div><strong>CC</strong><span>' + escapeHtml_(cc) + '</span></div>' +
        '<div><strong>Subject</strong><span>' + escapeHtml_(subject) + '</span></div>' +
      '</div>' +
      '<div class="body-preview">' + buildReminderEmailHtml_(audit, owner) + '</div>' +
    '</section>'
  ).join('');

  const blocked = withoutEmail.length
    ? '<section class="warning"><h3>Not sendable until an email is added</h3><p>' + withoutEmail.map(owner => escapeHtml_(owner.name + ' (' + owner.items.length + ' missing)')).join('<br>') + '</p></section>'
    : '';
  const unassigned = audit.unassigned.length
    ? '<section class="warning"><h3>Missing KPI rows without an owner</h3><p>' + audit.unassigned.map(item => escapeHtml_((item.monthName ? item.monthName + ' — ' : '') + item.site + ' — ' + item.label + ' — ' + item.sheet + ', row ' + item.row)).join('<br>') + '</p></section>'
    : '';
  const empty = !deliverable.length
    ? '<section class="empty"><h2>No email is ready to send</h2><p>All selected KPIs may be complete, or the relevant KPI owners do not yet have active email addresses in the KPI Email Directory.</p></section>'
    : '';

  return '<!doctype html><html><head><base target="_blank"><meta charset="utf-8"><style>' +
    '*{box-sizing:border-box}body{margin:0;background:#eef7fb;color:#092947;font-family:Arial,sans-serif}.top{position:sticky;top:0;z-index:2;padding:20px 26px;background:linear-gradient(115deg,#003b76,#00a0e1);color:#fff;box-shadow:0 8px 24px #003b7626}.top h1{margin:4px 0 6px;font-size:24px}.top p{margin:0;color:#dff5ff}.safe{display:inline-block;padding:6px 10px;border-radius:999px;background:#daf7eb;color:#007451;font-weight:700;font-size:12px}.stats{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}.stat{padding:8px 12px;border:1px solid #ffffff40;border-radius:10px;background:#ffffff18}.wrap{max-width:1020px;margin:24px auto;padding:0 18px 50px}.message,.warning,.empty{margin:0 0 22px;background:#fff;border:1px solid #d7e8f2;border-radius:18px;box-shadow:0 14px 40px #003b7612;overflow:hidden}.message-head{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;background:#f7fbfd;border-bottom:1px solid #dceaf3}.message-head span{font-size:11px;color:#587187;text-transform:uppercase;letter-spacing:.08em}.message-head h2{margin:3px 0 0;font-size:18px}.message-head b{color:#a66000;background:#fff3d7;padding:7px 10px;border-radius:999px}.envelope{padding:14px 20px;background:#fff;border-bottom:1px solid #dceaf3}.envelope div{display:grid;grid-template-columns:72px 1fr;gap:8px;padding:4px 0}.envelope strong{color:#587187}.body-preview{padding:20px;background:#f4f9fc;overflow:auto}.body-preview>div{max-width:900px;margin:auto;background:#fff}.warning,.empty{padding:18px 20px}.warning{border-left:5px solid #f0a202}.warning h3,.empty h2{margin:0 0 8px}.warning p,.empty p{margin:0;line-height:1.6;color:#49677f}@media(max-width:700px){.envelope div{grid-template-columns:1fr}.body-preview{padding:8px}}' +
    '</style></head><body>' +
    '<header class="top"><span class="safe">PREVIEW ONLY — NOTHING HAS BEEN SENT</span><h1>KPI reminder email preview</h1><p>These are the exact recipient details, subject and message body that the Sheet will use.</p>' +
      '<div class="stats"><div class="stat"><strong>Period:</strong> ' + escapeHtml_(reminderPeriodLabel_(audit)) + '</div><div class="stat"><strong>Ready emails:</strong> ' + deliverable.length + '</div><div class="stat"><strong>Missing entries:</strong> ' + audit.missingCount + '</div><div class="stat"><strong>Generated:</strong> ' + escapeHtml_(generated) + '</div></div>' +
    '</header><main class="wrap">' + empty + cards + blocked + unassigned + '</main></body></html>';
}

function reminderSentKey_(audit, owner) {
  const safeOwner = normalizeText_(owner.name).replace(/[^a-z0-9]+/g, '_').slice(0, 70);
  const today = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyyMMdd');
  return 'KPI_REMINDER_SENT_' + audit.year + '_JAN_' + (Number(audit.throughMonthIndex != null ? audit.throughMonthIndex : audit.monthIndex) + 1) + '_' + today + '_' + safeOwner;
}

function formatMissingKpiPreview_(audit) {
  if (!audit.selectedCount) return 'No KPI is selected for daily monitoring. Open the ☑ KPI checklist and select the required monthly KPIs first.';
  if (!audit.missingCount) return 'All monitored KPI entries are complete from January through the last completed month.';

  const lines = [
    'Selected KPIs monitored: ' + audit.selectedCount,
    'Missing entries: ' + audit.missingCount,
    'Owners identified: ' + audit.owners.length,
    ''
  ];
  audit.owners.forEach(owner => {
    lines.push(owner.name + ' — ' + owner.items.length + ' missing' + (owner.email ? '' : ' (EMAIL NOT CONFIGURED)'));
  });
  if (audit.unassigned.length) lines.push('Unassigned KPI rows — ' + audit.unassigned.length);
  if (audit.warnings.length) lines.push('', 'Warnings:', ...audit.warnings);
  return lines.join('\n').slice(0, 3500);
}

function formatSendResult_(result) {
  return [
    'Sent: ' + result.sent.length,
    'Already sent / skipped: ' + result.skipped.length,
    'Owners without configured email: ' + result.noEmail.length,
    result.noEmail.length ? '\nMissing email mapping: ' + result.noEmail.join(', ') : ''
  ].join('\n');
}

function deleteReminderTriggers_() {
  let removed = 0;
  ScriptApp.getProjectTriggers().forEach(trigger => {
    if (['runDailyKpiReminderCheck', 'runMonthlyKpiReminderCheck'].includes(trigger.getHandlerFunction())) {
      ScriptApp.deleteTrigger(trigger);
      removed++;
    }
  });
  return removed;
}

function deleteMonthlyReminderTriggers_() { return deleteReminderTriggers_(); }

function escapeHtml_(value) {
  return String(value === null || value === undefined ? '' : value)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

/** Lightweight first request used by the real loading sequence. */
function getDashboardMeta() {
  const ss = getSpreadsheet_();
  const sources = CONFIG.SITE_SHEETS.map(cfg => {
    const sh = findSheet_(ss, cfg.sheet);
    return {
      site: cfg.site,
      code: cfg.code,
      group: cfg.group,
      expectedSheet: cfg.sheet,
      found: !!sh,
      actualSheet: sh ? sh.getName() : null
    };
  });

  const userEmail = getActiveUserEmail_();
  let canViewVisitLog = false;
  try {
    canViewVisitLog = isVisitLogViewer_(userEmail);
    logDashboardVisit_(ss, userEmail);
  } catch (err) {
    // Visit logging must never block the dashboard from opening.
  }

  return {
    appTitle: CONFIG.APP_TITLE,
    year: CONFIG.YEAR,
    spreadsheetName: ss.getName(),
    autoRefreshSeconds: CONFIG.AUTO_REFRESH_SECONDS,
    months: CONFIG.MONTHS,
    sources: sources,
    generatedAt: new Date().toISOString(),
    canViewVisitLog: canViewVisitLog
  };
}

function getActiveUserEmail_() {
  const active = String(Session.getActiveUser().getEmail() || '').trim().toLowerCase();
  if (active) return active;
  return String(Session.getEffectiveUser().getEmail() || '').trim().toLowerCase();
}

function getVisitLogViewerEmails_() {
  const emails = VISIT_LOG_CONFIG.VIEWER_EMAILS.slice();
  const extra = String(PropertiesService.getScriptProperties().getProperty(VISIT_LOG_CONFIG.VIEWER_PROPERTY) || '');
  extra.split(/[,;\s]+/).forEach(function (entry) {
    const email = String(entry || '').trim().toLowerCase();
    if (email) emails.push(email);
  });
  return emails;
}

function isVisitLogViewer_(email) {
  const n = String(email || '').trim().toLowerCase();
  if (!n || n.indexOf('@') === -1) return false;

  const allowed = getVisitLogViewerEmails_();
  if (allowed.indexOf(n) !== -1) return true;
  if (n.endsWith('@airliquide') && allowed.indexOf(n + '.com') !== -1) return true;
  if (n.endsWith('@airliquide.com') && allowed.indexOf(n.replace(/\.com$/, '')) !== -1) return true;

  const local = n.split('@')[0];
  const domain = n.split('@')[1] || '';
  return local === 'hussam.alghamdi' && domain.indexOf('airliquide') !== -1;
}

function ensureVisitLogSheet_(ss) {
  let sheet = ss.getSheetByName(VISIT_LOG_CONFIG.SHEET);
  if (!sheet) sheet = ss.insertSheet(VISIT_LOG_CONFIG.SHEET);

  const headerRange = sheet.getRange(1, 1, 1, VISIT_LOG_CONFIG.HEADERS.length);
  const currentHeaders = headerRange.getValues()[0].map(cleanCellText_);
  if (currentHeaders.join('|') !== VISIT_LOG_CONFIG.HEADERS.join('|')) {
    headerRange.setValues([VISIT_LOG_CONFIG.HEADERS]);
  }

  headerRange
    .setBackground('#003b76')
    .setFontColor('#ffffff')
    .setFontWeight('bold');
  sheet.setFrozenRows(1);
  sheet.setColumnWidth(1, 280);
  sheet.setColumnWidth(2, 180);
  sheet.setColumnWidth(3, 180);
  sheet.setColumnWidth(4, 120);
  sheet.setTabColor('#7a1f1f');
  sheet.hideSheet();
  return sheet;
}

function formatVisitDate_(value) {
  if (!(value instanceof Date) || isNaN(value.getTime())) return '';
  return Utilities.formatDate(value, Session.getScriptTimeZone(), 'dd MMM yyyy, HH:mm');
}

function readVisitLog_(ss) {
  const sheet = ss.getSheetByName(VISIT_LOG_CONFIG.SHEET);
  if (!sheet || sheet.getLastRow() < 2) return [];

  return sheet.getRange(2, 1, sheet.getLastRow() - 1, VISIT_LOG_CONFIG.HEADERS.length)
    .getValues()
    .map(function (row) {
      const firstVisit = row[1] instanceof Date ? row[1] : null;
      const lastVisit = row[2] instanceof Date ? row[2] : null;
      return {
        email: cleanCellText_(row[0]),
        firstVisit: formatVisitDate_(firstVisit),
        lastVisit: formatVisitDate_(lastVisit),
        firstVisitAt: firstVisit ? firstVisit.getTime() : 0,
        lastVisitAt: lastVisit ? lastVisit.getTime() : 0,
        visitCount: Number(row[3]) || 0
      };
    })
    .filter(function (row) { return !!row.email; })
    .sort(function (a, b) { return b.lastVisitAt - a.lastVisitAt; });
}

function logDashboardVisit_(ss, email) {
  const visitorKey = String(email || '').trim().toLowerCase() || VISIT_LOG_CONFIG.UNSIGNED_LABEL;
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);
  try {
    const sheet = ensureVisitLogSheet_(ss);
    const now = new Date();
    const lastRow = sheet.getLastRow();
    if (lastRow < 2) {
      sheet.getRange(2, 1, 1, 4).setValues([[visitorKey, now, now, 1]]);
      return;
    }

    const range = sheet.getRange(2, 1, lastRow - 1, 4);
    const values = range.getValues();
    let found = -1;
    for (let i = 0; i < values.length; i++) {
      if (String(values[i][0] || '').trim().toLowerCase() === visitorKey) {
        found = i;
        break;
      }
    }

    if (found === -1) {
      sheet.appendRow([visitorKey, now, now, 1]);
      return;
    }

    const lastVisit = values[found][2];
    if (lastVisit instanceof Date && (now.getTime() - lastVisit.getTime()) < VISIT_LOG_CONFIG.MIN_VISIT_GAP_MS) {
      return;
    }

    const firstVisit = values[found][1] instanceof Date ? values[found][1] : now;
    const count = Number(values[found][3]) || 0;
    sheet.getRange(found + 2, 1, 1, 4).setValues([[visitorKey, firstVisit, now, count + 1]]);
  } finally {
    lock.releaseLock();
  }
}

function getDashboardVisitLog() {
  const email = getActiveUserEmail_();
  if (!isVisitLogViewer_(email)) {
    throw new Error('Visit history is private.');
  }

  const visitors = readVisitLog_(getSpreadsheet_()).map(function (row) {
    return {
      email: row.email,
      firstVisit: row.firstVisit || '—',
      lastVisit: row.lastVisit || '—',
      visitCount: row.visitCount
    };
  });

  let totalVisits = 0;
  visitors.forEach(function (row) { totalVisits += row.visitCount; });

  return {
    ok: true,
    uniqueVisitors: visitors.length,
    totalVisits: totalVisits,
    timezone: Session.getScriptTimeZone(),
    generatedAt: new Date().toISOString(),
    visitors: visitors
  };
}

/** Main live payload. Every refresh re-reads the KPI source tabs. */
function getDashboardData() {
  const ss = getSpreadsheet_();
  const sites = [];
  const warnings = [];

  CONFIG.SITE_SHEETS.forEach(cfg => {
    const sh = findSheet_(ss, cfg.sheet);
    if (!sh) {
      warnings.push('Missing source sheet: ' + cfg.sheet);
      return;
    }

    try {
      sites.push(parseSiteSheet_(sh, cfg));
    } catch (err) {
      warnings.push(cfg.site + ': ' + (err && err.message ? err.message : String(err)));
    }
  });

  const metrics = [];
  sites.forEach(site => site.metrics.forEach(m => metrics.push(m)));
  const reporting = deriveReporting_(sites);

  return {
    appTitle: CONFIG.APP_TITLE,
    year: CONFIG.YEAR,
    spreadsheetName: ss.getName(),
    generatedAt: new Date().toISOString(),
    autoRefreshSeconds: CONFIG.AUTO_REFRESH_SECONDS,
    months: CONFIG.MONTHS,
    reporting: reporting,
    sites: sites.map(s => ({
      site: s.site,
      code: s.code,
      group: s.group,
      sheet: s.sheet,
      latestMonthIndex: s.latestMonthIndex,
      metricCount: s.metrics.length
    })),
    metrics: metrics,
    warnings: warnings
  };
}

function getSpreadsheet_() {
  const props = PropertiesService.getScriptProperties();
  const id = props.getProperty('SPREADSHEET_ID');

  if (id) {
    return SpreadsheetApp.openById(id);
  }

  // This fallback is useful while testing from the bound sheet editor.
  const active = SpreadsheetApp.getActiveSpreadsheet();
  if (active) {
    props.setProperty('SPREADSHEET_ID', active.getId());
    return active;
  }

  throw new Error('Dashboard is not initialized. Run setupDashboard() once from the bound Google Sheet.');
}

function findSheet_(ss, expectedName) {
  const exact = ss.getSheetByName(expectedName);
  if (exact) return exact;

  const wanted = normalizeText_(expectedName);
  return ss.getSheets().find(sh => normalizeText_(sh.getName()) === wanted) || null;
}

function parseSiteSheet_(sheet, cfg) {
  const values = sheet.getDataRange().getValues();
  if (!values || !values.length) {
    return {
      site: cfg.site, code: cfg.code, group: cfg.group, sheet: sheet.getName(),
      latestMonthIndex: -1, metrics: []
    };
  }

  const headerRowIndex = findHeaderRow_(values);
  if (headerRowIndex < 0) {
    throw new Error('Could not identify the KPI header row.');
  }

  const headers = values[headerRowIndex].map(v => normalizeText_(v));
  const kpiCol = findHeaderIndex_(headers, ['kpi']);
  const procedureCol = findHeaderIndex_(headers, ['alar procedure', 'procedure']);
  const siteCol = findHeaderIndex_(headers, ['site']);
  const ownerCol = findHeaderIndex_(headers, ['kpi responsible', 'responsible', 'owner']);
  const objectiveCol = findHeaderIndex_(headers, ['objective', 'formula']);
  const targetCol = findHeaderIndex_(headers, ['target value', 'target']);
  const monthLayout = resolveMonthLayout_(values, headerRowIndex, headers);
  const monthCols = monthLayout.monthCols;
  const dataStartRow = monthLayout.dataStartRow;

  if (kpiCol < 0) throw new Error('KPI column not found.');

  const metrics = [];
  for (let r = dataStartRow; r < values.length; r++) {
    const row = values[r];
    const label = cleanCellText_(row[kpiCol]);
    if (!label || normalizeText_(label) === 'kpi') continue;

    const objective = objectiveCol >= 0 ? cleanCellText_(row[objectiveCol]) : '';
    const targetRaw = targetCol >= 0 ? row[targetCol] : null;
    const ownerRaw = ownerCol >= 0 ? cleanCellText_(row[ownerCol]) : '';
    const procedure = procedureCol >= 0 ? cleanCellText_(row[procedureCol]) : '';
    const rowSite = siteCol >= 0 ? cleanCellText_(row[siteCol]) : '';

    const kind = classifyMetric_(label, objective);
    const category = categoryForKind_(kind);
    const isPercent = isPercentageKind_(kind, label, objective, targetRaw);
    const aggregation = aggregationForKind_(kind, isPercent);
    const direction = directionForKind_(kind, label, objective);
    const derived = isDerivedMetric_(label, kind);

    let monthly = monthCols.map(col => col >= 0 ? toNumeric_(row[col]) : null);
    if (isPercent) monthly = monthly.map(v => normalizePercent_(v));

    let annualTarget = parseTargetNumber_(targetRaw);
    if (isPercent) annualTarget = normalizePercent_(annualTarget);

    const ytdActual = aggregateMonthly_(monthly, aggregation);
    const latestMonthIndex = latestNumericIndex_(monthly);
    const latestValue = latestMonthIndex >= 0 ? monthly[latestMonthIndex] : null;

    metrics.push({
      id: cfg.code + '-' + (r + 1),
      site: cfg.site,
      siteCode: cfg.code,
      group: cfg.group,
      sheet: sheet.getName(),
      row: r + 1,
      sourceSite: rowSite || cfg.site,
      label: label,
      procedure: procedure,
      owners: splitOwners_(ownerRaw),
      objective: objective,
      targetRaw: cleanCellText_(targetRaw),
      annualTarget: annualTarget,
      monthly: monthly,
      ytdActual: ytdActual,
      latestValue: latestValue,
      latestMonthIndex: latestMonthIndex,
      kind: kind,
      category: category,
      isPercent: isPercent,
      aggregation: aggregation,
      direction: direction,
      derived: derived,
      hasData: latestMonthIndex >= 0
    });
  }

  return {
    site: cfg.site,
    code: cfg.code,
    group: cfg.group,
    sheet: sheet.getName(),
    latestMonthIndex: latestSiteMonth_(metrics),
    metrics: metrics
  };
}

function monthHeaderAliases_(monthIndex) {
  const aliases = [normalizeText_(CONFIG.MONTHS[monthIndex])];
  if (monthIndex === 0) aliases.push('jan');
  if (monthIndex === 1) aliases.push('feb');
  if (monthIndex === 2) aliases.push('mar');
  if (monthIndex === 3) aliases.push('apr');
  if (monthIndex === 4) aliases.push('may');
  if (monthIndex === 5) aliases.push('jun');
  if (monthIndex === 6) aliases.push('jul');
  if (monthIndex === 7) aliases.push('aug');
  if (monthIndex === 8) aliases.push('sep', 'sept');
  if (monthIndex === 9) aliases.push('oct');
  if (monthIndex === 10) aliases.push('nov');
  if (monthIndex === 11) aliases.push('dec');
  return aliases;
}

function headerMatchesMonthAlias_(header, aliases) {
  if (!header) return false;
  if (aliases.includes(header)) return true;
  return aliases.some(alias => {
    if (header === alias) return true;
    if (header.startsWith(alias + ' ') || header.startsWith(alias + '-') || header.startsWith(alias + '/')) {
      return true;
    }
    return header.length > alias.length &&
      header.startsWith(alias) &&
      /[\d/-]/.test(header.charAt(alias.length));
  });
}

function rowHasMonthHeader_(normalizedRow) {
  return normalizedRow.some(header => {
    for (let monthIndex = 0; monthIndex < CONFIG.MONTHS.length; monthIndex++) {
      if (headerMatchesMonthAlias_(header, monthHeaderAliases_(monthIndex))) return true;
    }
    return false;
  });
}

function resolveMonthLayout_(values, headerRowIndex, headers) {
  let monthCols = CONFIG.MONTHS.map((month, monthIndex) => findMonthColumn_(headers, month, monthIndex));
  let dataStartRow = headerRowIndex + 1;
  const primaryFound = monthCols.filter(col => col >= 0).length;

  if (primaryFound < 3 && headerRowIndex + 1 < values.length) {
    const subHeaders = values[headerRowIndex + 1].map(v => normalizeText_(v));
    const subMonthCols = CONFIG.MONTHS.map((month, monthIndex) => findMonthColumn_(subHeaders, month, monthIndex));
    const subFound = subMonthCols.filter(col => col >= 0).length;
    if (subFound > primaryFound) {
      monthCols = subMonthCols;
      dataStartRow = headerRowIndex + 2;
    }
  }

  return { monthCols: monthCols, dataStartRow: dataStartRow };
}

function findHeaderRow_(values) {
  const maxRows = Math.min(values.length, 10);
  for (let r = 0; r < maxRows; r++) {
    const normalized = values[r].map(v => normalizeText_(v));
    const hasKpi = normalized.some(v => v === 'kpi' || v.indexOf('kpi') === 0);
    const hasMonth = rowHasMonthHeader_(normalized) ||
      (r + 1 < maxRows && rowHasMonthHeader_(values[r + 1].map(v => normalizeText_(v))));
    if (hasKpi && hasMonth) return r;
  }
  return -1;
}

function findHeaderIndex_(headers, candidates) {
  const wanted = candidates.map(normalizeText_);
  for (let i = 0; i < headers.length; i++) {
    if (wanted.includes(headers[i])) return i;
  }
  for (let i = 0; i < headers.length; i++) {
    if (wanted.some(w => headers[i].indexOf(w) >= 0)) return i;
  }
  return -1;
}

function findMonthColumn_(headers, month, monthIndex) {
  const aliases = monthHeaderAliases_(monthIndex);
  for (let i = 0; i < headers.length; i++) {
    if (headerMatchesMonthAlias_(headers[i], aliases)) return i;
  }
  return -1;
}

function classifyMetric_(label, objective) {
  const t = normalizeText_(label + ' ' + (objective || ''));

  if (/working hours?/.test(t) && /contractor/.test(t)) return 'contractor_hours';
  if (/working hours?/.test(t) && /(alar employee|employees?)/.test(t)) return 'employee_hours';

  if (/bsv/.test(t) && /quality/.test(t)) return 'bsv_quality';
  if (/bsv/.test(t) && /(conducted by fm|management team|by fm)/.test(t)) return 'bsv_management';
  if (/bsv/.test(t) && /total/.test(t)) return 'bsv_total_derived';
  if (/bsv/.test(t)) return 'bsv';

  if (/walkthrough|anomal(?:y|ies) hunt/.test(t)) return 'walkthrough';
  if (/emergency.*(?:mock|moc?k).*drill|(?:mock|moc?k).*drill/.test(t)) return 'emergency_drill';
  if (/employee.*trained.*erp|trained on erp/.test(t)) return 'erp_training';
  if (/fire.?fighting.*(?:readiness|inspection)|inspection.*fire.?fighting/.test(t)) return 'fire_readiness';
  if (/emergency.*plan.*review|annual review.*erp|preparedness plans? reviewed/.test(t)) return 'emergency_plan_review';

  if (/swp.*compliance/.test(t)) return 'swp_compliance';
  if (/audit on swp|swp audit(?! compliance)/.test(t)) return 'swp_audit';
  if (/rca development/.test(t)) return 'rca_development';
  if (/rca action/.test(t)) return 'rca_actions';
  if (/ara revision/.test(t)) return 'ara_revision';
  if (/ara action/.test(t)) return 'ara_actions';
  if (/audit.*ara.*eis|ara.*eis.*testing/.test(t)) return 'ara_eis_audit';
  if (/eis.*(?:tested|management)|monitoring.*eis/.test(t)) return 'eis';
  if (/hse site visits? by gm/.test(t)) return 'gm_visit';

  if (/fatal/.test(t)) return 'fatal';
  if (/nlta/.test(t)) return 'nlta';
  if (/(^|\W)lta(\W|$)/.test(t)) return 'lta';
  if (/psse|pssi/.test(t)) return 'psse';
  if (/(^|\W)pse(\W|$)/.test(t)) return 'pse';
  if (/commuting accident/.test(t)) return 'commuting';
  if (/first aid/.test(t)) return 'first_aid';
  if (/near miss/.test(t)) return 'near_miss';
  if (/unsafe.*act/.test(t)) return 'unsafe_act';
  if (/unsafe.*(?:condition|circumstance|observation)/.test(t)) return 'unsafe_condition';
  if (/life.?saving rules?|12 life saving/.test(t)) return 'lsr_breach';

  if (/environment.*incident/.test(t)) return 'environment_incident';
  if (/non.?hazardous waste/.test(t)) return 'nonhaz_waste';
  if (/hazardous waste/.test(t)) return 'haz_waste';
  if (/electricity consumption/.test(t)) return 'electricity';
  if (/process waste water|wastewater/.test(t)) return 'wastewater';
  if (/water consumption/.test(t)) return 'water';
  if (/used oil/.test(t)) return 'used_oil';
  if (/metallic waste/.test(t)) return 'metallic_waste';
  if (/ghg emission/.test(t)) return 'ghg';
  if (/nox/.test(t)) return 'nox';

  return 'other';
}

function categoryForKind_(kind) {
  if (['employee_hours', 'contractor_hours'].includes(kind)) return 'Workforce';
  if (['fatal', 'lta', 'nlta', 'psse', 'pse', 'commuting', 'first_aid', 'lsr_breach'].includes(kind)) return 'Safety Events';
  if (['bsv', 'bsv_quality', 'bsv_management', 'bsv_total_derived', 'near_miss', 'unsafe_condition', 'unsafe_act', 'walkthrough', 'gm_visit'].includes(kind)) return 'Leading Indicators';
  if (['emergency_drill', 'erp_training', 'fire_readiness', 'emergency_plan_review'].includes(kind)) return 'Emergency & Preparedness';
  if (['swp_audit', 'swp_compliance', 'rca_development', 'rca_actions', 'ara_revision', 'ara_actions', 'ara_eis_audit', 'eis'].includes(kind)) return 'Risk & Assurance';
  if (['environment_incident', 'nonhaz_waste', 'haz_waste', 'electricity', 'water', 'wastewater', 'used_oil', 'metallic_waste', 'ghg', 'nox'].includes(kind)) return 'Environment';
  return 'Other';
}

function isPercentageKind_(kind, label, objective, targetRaw) {
  if ([
    'bsv_quality', 'erp_training', 'emergency_plan_review', 'swp_compliance',
    'rca_development', 'rca_actions', 'ara_revision', 'ara_actions', 'eis'
  ].includes(kind)) return true;

  // Explicit count / exposure / environmental quantities must never be converted to percentages
  // even if their objective text happens to contain a % reduction target.
  if ([
    'employee_hours', 'contractor_hours', 'bsv', 'bsv_management', 'bsv_total_derived',
    'walkthrough', 'emergency_drill', 'fire_readiness', 'swp_audit', 'ara_eis_audit',
    'gm_visit', 'fatal', 'lta', 'nlta', 'psse', 'pse', 'commuting', 'first_aid',
    'near_miss', 'unsafe_condition', 'unsafe_act', 'lsr_breach', 'environment_incident',
    'nonhaz_waste', 'haz_waste', 'electricity', 'water', 'wastewater', 'used_oil',
    'metallic_waste', 'ghg', 'nox'
  ].includes(kind)) return false;

  const t = normalizeText_(label + ' ' + (objective || '') + ' ' + cleanCellText_(targetRaw));
  return t.indexOf('%') >= 0 || /percentage|compliance rate/.test(t);
}

function aggregationForKind_(kind, isPercent) {
  if (isPercent) return 'average';
  if (['ara_revision', 'ara_actions', 'eis', 'emergency_plan_review', 'swp_audit'].includes(kind)) return 'latest';
  return 'sum';
}

function directionForKind_(kind, label, objective) {
  if (['fatal', 'lta', 'nlta', 'psse', 'pse', 'commuting', 'first_aid', 'lsr_breach', 'environment_incident'].includes(kind)) {
    return 'lower';
  }

  if ([
    'bsv', 'bsv_quality', 'bsv_management', 'near_miss', 'unsafe_condition',
    'walkthrough', 'gm_visit', 'emergency_drill', 'erp_training', 'fire_readiness',
    'emergency_plan_review', 'swp_audit', 'swp_compliance', 'rca_development',
    'rca_actions', 'ara_revision', 'ara_actions', 'ara_eis_audit', 'eis'
  ].includes(kind)) {
    return 'higher';
  }

  const t = normalizeText_(label + ' ' + (objective || ''));
  if (/\bzero\b|\bmax\b|not more than|less than/.test(t)) return 'lower';
  if (/minimum|at least|not less than|>=/.test(t)) return 'higher';
  return 'neutral';
}

function isDerivedMetric_(label, kind) {
  const t = normalizeText_(label);
  return kind === 'bsv_total_derived' || /^=/.test(String(label).trim()) || /total number|^total /.test(t);
}

function splitOwners_(raw) {
  if (!raw) return [];
  const parts = String(raw)
    .replace(/•/g, '\n')
    .split(/[\n;,]+/)
    .map(s => s.replace(/^\s*[-–—]+\s*/, '').trim())
    .filter(Boolean);

  return Array.from(new Set(parts));
}

function deriveReporting_(sites) {
  let globalLatest = -1;
  sites.forEach(s => { if (s.latestMonthIndex > globalLatest) globalLatest = s.latestMonthIndex; });

  const industrialCodes = ['YAN-HGU', 'QUR', 'YPL', 'JUB'];
  const industrial = sites.filter(s => industrialCodes.includes(s.code));
  let latestComplete = -1;

  for (let monthIndex = 0; monthIndex < 12; monthIndex++) {
    const allHaveExposure = industrial.length > 0 && industrial.every(site => {
      const exposure = site.metrics.find(m => m.kind === 'employee_hours');
      return exposure && exposure.monthly[monthIndex] !== null;
    });
    if (allHaveExposure) latestComplete = monthIndex;
  }

  return {
    globalLatestMonthIndex: globalLatest,
    latestCompleteMonthIndex: latestComplete,
    hasPartialLaterData: globalLatest > latestComplete,
    globalLatestMonth: globalLatest >= 0 ? CONFIG.MONTHS[globalLatest] : null,
    latestCompleteMonth: latestComplete >= 0 ? CONFIG.MONTHS[latestComplete] : null
  };
}

function latestSiteMonth_(metrics) {
  let idx = -1;
  metrics.forEach(m => { if (m.latestMonthIndex > idx) idx = m.latestMonthIndex; });
  return idx;
}

function aggregateMonthly_(monthly, mode) {
  const nums = monthly.filter(v => typeof v === 'number' && isFinite(v));
  if (!nums.length) return null;
  if (mode === 'average') return nums.reduce((a, b) => a + b, 0) / nums.length;
  if (mode === 'latest') {
    for (let i = monthly.length - 1; i >= 0; i--) {
      if (typeof monthly[i] === 'number' && isFinite(monthly[i])) return monthly[i];
    }
    return null;
  }
  return nums.reduce((a, b) => a + b, 0);
}

function latestNumericIndex_(monthly) {
  for (let i = monthly.length - 1; i >= 0; i--) {
    if (typeof monthly[i] === 'number' && isFinite(monthly[i])) return i;
  }
  return -1;
}

function parseTargetNumber_(value) {
  if (value === null || value === undefined || value === '') return null;
  if (typeof value === 'number' && isFinite(value)) return value;
  if (typeof value === 'boolean') return null;

  const text = String(value).trim();
  if (!text || /variable|n\/a|na$/i.test(text)) return null;
  const match = text.replace(/,/g, '').match(/-?\d+(?:\.\d+)?/);
  return match ? Number(match[0]) : null;
}

function toNumeric_(value) {
  if (value === null || value === undefined || value === '') return null;
  if (typeof value === 'number') return isFinite(value) ? value : null;
  if (typeof value === 'boolean') return null;
  if (value instanceof Date) {
    const time = value.getTime();
    if (isNaN(time)) return null;
    return Number(Utilities.formatDate(value, Session.getScriptTimeZone(), 'yyyyMMdd'));
  }

  const raw = String(value).trim();
  if (!raw || /^(n\/a|na|-)$/i.test(raw)) return null;

  const s = raw.replace(/,/g, '').replace(/\s+/g, '');
  if (/^-?\d+(?:\.\d+)?%$/.test(s)) return Number(s.replace('%', ''));
  if (/^-?\d+(?:\.\d+)?$/.test(s)) return Number(s);

  const isoDate = raw.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (isoDate) return Number(isoDate[1] + isoDate[2] + isoDate[3]);

  const slashDate = raw.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/);
  if (slashDate) {
    let year = Number(slashDate[3]);
    if (year < 100) year += 2000;
    const month = String(slashDate[2]).padStart(2, '0');
    const day = String(slashDate[1]).padStart(2, '0');
    return Number(String(year) + month + day);
  }

  return parseTargetNumber_(value);
}

function normalizePercent_(value) {
  if (value === null || value === undefined || typeof value !== 'number' || !isFinite(value)) return value;
  if (Math.abs(value) <= 1.5) return value * 100;
  return value;
}

function cleanCellText_(value) {
  if (value === null || value === undefined) return '';
  if (value instanceof Date) return Utilities.formatDate(value, Session.getScriptTimeZone(), 'yyyy-MM-dd');
  return String(value).trim();
}

function normalizeText_(value) {
  return cleanCellText_(value)
    .toLowerCase()
    .replace(/[_]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}
